    {
      "id": "c2",
      "type": "text",
      "title": "Morning Remembrance — Ayat al-Kursi",
      "category": "morning",
      "tags": ["protection", "morning"],
      "arabicText": "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ",
      "transliteration": "Allahu la ilaha illa huwa al-hayyul-qayyum",
      "translation": "Allah — there is no deity except Him, the Ever-Living, the Sustainer of existence.",
      "mediaUrl": null,
      "thumbnailUrl": null,
      "authorId": "admin1",
      "authorName": "Alamiyah Editors",
      "status": "published",
      "createdAt": "2026-09-09T06:30:00.000Z",
      "scheduledAt": null,
      "featured": false
    },
    {
      "id": "c3",
      "type": "text",
      "title": "Evening Adhkar — Seeking Refuge",
      "category": "evening",
      "tags": ["evening", "refuge"],
      "arabicText": "أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ",
      "transliteration": "A'udhu bi kalimatillahi at-tammati min sharri ma khalaq",
      "translation": "I seek refuge in the perfect words of Allah from the evil of what He has created.",
      "mediaUrl": null,
      "thumbnailUrl": null,
      "authorId": "admin2",
      "authorName": "Sister Amina",
      "status": "published",
      "createdAt": "2026-09-08T17:00:00.000Z",
      "scheduledAt": null,
      "featured": false
    },
